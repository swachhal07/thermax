{
  "name": "thermax-backend",
  "private": true,
  "version": "0.1.0",
  "description": "API for the Thermax site — client ledger and product application ranges.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "dev:db": "node devdb.mjs",
    "start": "node src/server.js",
    "seed": "node --env-file=.env src/seed/seed.js",
    "seed:fresh": "node --env-file=.env src/seed/seed.js --fresh",
    "admin": "node --env-file=.env src/seed/createAdmin.js",
    "test": "node --test src/test/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^2.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0"
  }
}
