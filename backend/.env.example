# Copy to .env and fill in. .env is gitignored — never commit real values.

NODE_ENV=development
PORT=4000

# Mongo connection string. Local: mongodb://127.0.0.1:27017/thermax
# Atlas: mongodb+srv://<user>:<pass>@<cluster>/thermax?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/thermax

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Signing secret for admin tokens. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Guards POST /api/v1/auth/register once the first admin exists.
# Leave blank to close registration entirely after bootstrap.
ADMIN_SETUP_KEY=
# ─── The admin login ───────────────────────────────────────────────
# The account `npm run seed` and `npm run admin` create. Change either value
# and run one of them again — an existing address has its password reset.
# Password must be at least 10 characters. Leave ADMIN_PASSWORD blank and no
# account is touched.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# admin (default) or editor. Both can edit; the distinction is there for later.
ADMIN_ROLE=admin


# Cloudinary — dashboard > Product Environment Credentials.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Everything the API uploads is namespaced under this folder.
CLOUDINARY_FOLDER=thermax
